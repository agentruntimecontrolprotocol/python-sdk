digraph SessionLifecycle {
  rankdir=TB;
  bgcolor="transparent";
  fontname="TT Commons Pro Trial";
  splines=spline;
  nodesep=0.32;
  ranksep=0.55;
  pad="0.35,0.25";

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="white",
    color="#CBD5E1",
    fontname="TT Commons Pro Trial",
    fontsize=11,
    fontcolor="#1F2937",
    margin="0.22,0.11",
    penwidth=1.0
  ];

  edge [
    fontname="TT Commons Pro Trial",
    fontsize=9,
    fontcolor="#64748B",
    color="#94A3B8",
    penwidth=1.1,
    arrowsize=0.75,
    arrowhead=vee
  ];

  OPENING [
    label=<<FONT POINT-SIZE="12"><B>OPENING</B></FONT>>,
    fillcolor="#3B82F6", color="#2563EB",
    fontcolor="white", penwidth=1.4
  ];

  HELLO_SENT [label="HELLO_SENT"];

  WELCOMED [
    label=<<FONT POINT-SIZE="12"><B>WELCOMED</B></FONT>>,
    fillcolor="#F59E0B", color="#D97706",
    fontcolor="white", penwidth=1.4
  ];

  RESUMING [label="RESUMING"];
  CLOSING  [label="CLOSING"];
  CLOSED   [label="CLOSED"];

  edge [color="#64748B", penwidth=1.2];
  OPENING    -> HELLO_SENT [label="session.hello"];
  HELLO_SENT -> WELCOMED   [label="session.welcome"];
  WELCOMED   -> CLOSING    [label="session.bye"];
  CLOSING    -> CLOSED     [label="transport close"];

  edge [color="#CBD5E1", penwidth=1.0];
  WELCOMED -> RESUMING [label="transport drop"];
  RESUMING -> WELCOMED [label="session.hello{resume}"];

  WELCOMED -> CLOSING [
    style=dashed, color="#F472B6", penwidth=1.1,
    constraint=false,
    label=<<FONT COLOR="#DB2777">HEARTBEAT_LOST</FONT>>, fontsize=9
  ];
}
